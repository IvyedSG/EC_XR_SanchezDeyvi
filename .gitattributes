# ============================================================
#  Unity — .gitattributes
#  Git LFS para assets binarios. Evita corrupción de archivos
#  y previene el problema "binary file instead of text file"
#  que impide compilar.
# ============================================================

# --- Forzar LF en archivos de texto (evita conflictos de fin de línea)
* text=auto eol=lf

# --- Archivos que DEBEN tratarse como binarios ---------------------
*.meta        -text -diff merge=unitymeta eol=lf
*.unity      -text -diff merge=unityyaml eol=lf
*.prefab     -text -diff merge=unityyaml eol=lf
*.asset      -text -diff merge=unityyaml eol=lf
*.mat        -text -diff merge=unityyaml eol=lf
*.controller -text -diff merge=unityyaml eol=lf
*.anim       -text -diff merge=unityyaml eol=lf
*.physicMaterial -text -diff merge=unityyaml eol=lf
*.playable   -text -diff merge=unityyaml eol=lf
*.mask       -text -diff merge=unityyaml eol=lf
*.brush      -text -diff merge=unityyaml eol=lf
*.signal     -text -diff merge=unityyaml eol=lf
*.guiskin    -text -diff merge=unityyaml eol=lf
*.fontsettings -text -diff merge=unityyaml eol=lf
*.shadervariants -text -diff merge=unityyaml eol=lf
*.lighting   -text -diff merge=unityyaml eol=lf
*.giparams   -text -diff merge=unityyaml eol=lf
*.renderTexture -text -diff merge=unityyaml eol=lf
*.spriteatlas -text -diff merge=unityyaml eol=lf
*.terrainlayer -text -diff merge=unityyaml eol=lf

# --- Assets binarios pesados -> Git LFS ----------------------------
*.psd       filter=lfs diff=lfs merge=lfs -text
*.exr       filter=lfs diff=lfs merge=lfs -text
*.hdr       filter=lfs diff=lfs merge=lfs -text
*.tif       filter=lfs diff=lfs merge=lfs -text
*.tiff      filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.flac      filter=lfs diff=lfs merge=lfs -text
*.mp4       filter=lfs diff=lfs merge=lfs -text
*.mov       filter=lfs diff=lfs merge=lfs -text
*.avi       filter=lfs diff=lfs merge=lfs -text
*.webm      filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.gif       filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
*.bmp       filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.blend1    filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# --- Build de Unity ------------------------------------------------
*.apk       filter=lfs diff=lfs merge=lfs -text
*.aab       filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# --- Documentos / misc --------------------------------------------
*.pdf       filter=lfs diff=lfs merge=lfs -text
*.docx      filter=lfs diff=lfs merge=lfs -text
*.pptx      filter=lfs diff=lfs merge=lfs -text
*.xlsx      filter=lfs diff=lfs merge=lfs -text
